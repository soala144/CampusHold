# Copy to .env.local and fill in values. Never commit real credentials.

# Postgres (Pxxl). Use the connection string from your Pxxl dashboard.
DATABASE_URL=

# Password for every demo account created by `pnpm db:seed`.
SEED_PASSWORD=

# Simulated payments: "false" hides test controls. Ignored when PAYMENTS_PROVIDER=bachs.
SIMULATION_ENABLED=true

# Email/SMS aren't connected yet: show verification codes on the verify screen.
# Set to false once an email/SMS provider is set up.
SHOW_CODES_ON_SCREEN=true

# Public base URL. Must be https for Bachs to send people back after paying;
# on http (local) the Bachs page opens in a new tab and the app polls instead.
APP_URL=http://localhost:3000

# Payments: "bachs" for real (sandbox or live) payments, anything else to simulate.
PAYMENTS_PROVIDER=bachs
BACHS_API_KEY=
# Signing secret of the endpoint registered at https://<your-domain>/api/webhooks/bachs
BACHS_WEBHOOK_SECRET=
BACHS_ENV=sandbox

# Cloudinary: signed direct uploads for attachments and service covers.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
