# Copy to .env.local and fill in values. Never commit real credentials.

# Postgres (Pxxl). Use the connection string from your Pxxl dashboard.
DATABASE_URL=

# Password for every demo account created by `pnpm db:seed`.
SEED_PASSWORD=

# Payments are simulated until Stage 4. Set to "false" to hide test controls.
SIMULATION_ENABLED=true

# Email/SMS aren't connected yet: show verification codes on the verify screen.
# Set to false once an email/SMS provider is set up.
SHOW_CODES_ON_SCREEN=true

# Base URL used in password-reset links.
APP_URL=http://localhost:3000

# Payment provider (Stage 4 — not used yet)
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_ENVIRONMENT=sandbox
